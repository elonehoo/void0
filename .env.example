# Copy to .env for a public HTTPS deployment. Set DNS and open TCP 80/443 first.
VOID0_DOMAIN=panel.example.com
VOID0_PUBLIC_URL=https://panel.example.com

# Optional official authorization. Register your own applications first:
# See docs/provider-oauth.md; keep Client Secrets only on the backend.
# VOID0_GITHUB_CLIENT_ID=
# VOID0_GITHUB_CLIENT_SECRET=
# VOID0_VERCEL_CLIENT_ID=
# VOID0_VERCEL_CLIENT_SECRET=
# VOID0_VERCEL_INTEGRATION_SLUG=

# Optional independent publisher. Its request token belongs in a private 0600 file.
# VOID0_PUBLISHER_URL=https://publisher.example.com
# VOID0_PUBLISHER_TOKEN_FILE=/srv/void0/publisher-api-token

# For PostgreSQL Compose, generate separate random passwords:
# node script/setup-postgres.mjs .void0-postgres.env
# docker compose --env-file .void0-postgres.env -f compose.yaml -f compose.postgres.yaml up -d --build
