[Unit]
Description=void0 OS outbound server management service
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/serverdesk-agent/config.json

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/serverdesk-agent/daemon.py run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=process
NoNewPrivileges=true
ProtectSystem=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=serverdesk-agent

[Install]
WantedBy=multi-user.target
