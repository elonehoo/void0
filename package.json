{
  "name": "void0",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted project, server, and Docker deployment management",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/main.js",
    "test": "./script/test-web.sh",
    "check": "tsc --noEmit",
    "import:desktop": "tsx script/import-desktop.ts",
    "migrate:postgres": "tsx script/migrate-postgres.ts",
    "backup:sqlite": "tsx script/backup-sqlite.ts",
    "backup:postgres": "tsx script/backup-postgres.ts",
    "restore:postgres": "tsx script/restore-postgres.ts",
    "publisher": "node build/server/publisher-main.js",
    "publisher:setup": "node build/server/publisher-setup.js",
    "check:public": "node script/check-public-files.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.6",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elonehoo/void0.git"
  },
  "bugs": {
    "url": "https://github.com/elonehoo/void0/issues"
  },
  "homepage": "https://github.com/elonehoo/void0#readme"
}
